{
  "name": "seaglass-open",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "deploy": "npm run build && wrangler deploy && wrangler d1 migrations apply seaglass --remote",
    "deploy:ci": "node scripts/ci-deploy.mjs",
    "icons": "node scripts/make-icons.mjs",
    "db:local": "wrangler d1 migrations apply seaglass --local",
    "db:remote": "wrangler d1 migrations apply seaglass --remote",
    "typecheck": "tsc --noEmit",
    "wif:keygen": "node scripts/wif-keygen.mjs",
    "push:keygen": "node scripts/push-keygen.mjs",
    "data:keygen": "node scripts/data-keygen.mjs",
    "voice:model": "node scripts/voice-model.mjs",
    "backup:restore": "node scripts/restore-backup.mjs",
    "check:scope": "node scripts/check-scope.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@cloudflare/workers-oauth-provider": "^1.2.4",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@huggingface/transformers": "^4.3.2",
    "@tiptap/extension-code-block-lowlight": "^3.33.0",
    "@tiptap/extension-color": "^3.33.0",
    "@tiptap/extension-details": "^3.33.0",
    "@tiptap/extension-drag-handle-react": "^3.33.0",
    "@tiptap/extension-highlight": "^3.33.0",
    "@tiptap/extension-image": "^3.33.0",
    "@tiptap/extension-mathematics": "^3.33.0",
    "@tiptap/extension-mention": "^3.33.0",
    "@tiptap/extension-placeholder": "^3.33.0",
    "@tiptap/extension-subscript": "^3.33.0",
    "@tiptap/extension-superscript": "^3.33.0",
    "@tiptap/extension-table": "^3.33.0",
    "@tiptap/extension-table-of-contents": "^3.33.0",
    "@tiptap/extension-task-item": "^3.33.0",
    "@tiptap/extension-task-list": "^3.33.0",
    "@tiptap/extension-text-align": "^3.33.0",
    "@tiptap/extension-text-style": "^3.33.0",
    "@tiptap/extension-typography": "^3.33.0",
    "@tiptap/extension-unique-id": "^3.33.0",
    "@tiptap/extension-youtube": "^3.33.0",
    "@tiptap/pm": "^3.33.0",
    "@tiptap/react": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "@tiptap/suggestion": "^3.33.0",
    "dompurify": "^3.4.17",
    "hono": "^4.13.16",
    "katex": "^0.18.10",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.69.0",
    "marked": "^18.1.3",
    "perfect-freehand": "^1.2.2",
    "qrcode-generator": "^1.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanitize-html": "^2.18.1",
    "turndown": "^7.2.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@cloudflare/workers-types": "^5.20261104.1",
    "@types/dompurify": "^3.0.5",
    "@types/katex": "^0.16.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "wrangler": "^4.158.0"
  },
  "version": "0.2.4",
  "license": "Apache-2.0",
  "description": "Seaglass Open: a private notes app you run yourself on Cloudflare",
  "repository": {
    "type": "git",
    "url": "https://github.com/kidorange125-star/seaglass-open"
  }
}
